<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">
    <Script file = "MainWindow.lua"/>
    <!--inherits="UIPanelDialogTemplate"  BasicFrameTemplate -->
    <Frame inherits="BasicFrameTemplate" name="RPTT_MainWindow" parent="UIParent" toplevel="true" enableMouse="true" hidden="true" registerForDrag="LeftButton" movable="true"> 
                <KeyValues>
                    <KeyValue key="backdropInfo" value="MainWindowTimerHeaderBackdrop" type="global" />
                </KeyValues>
        <Scripts>
            <OnLoad function="MainWindow_OnLoad" />
            <OnShow function="MainWindow_OnEnable"/>
        </Scripts>
        <Size x="250" y="300"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
             <!--   <Texture file="interface/DialogFrame/UIFrameDialogBoxBackground.BLP" /> 
                <Texture file="interface/FrameGeneral/UI-Background-Marble.PNG" />-->
            </Layer>
            <Layer level="BORDER ">
            </Layer>
            <Layer level="ARTWORK">
               <!-- <Texture file="interface/icons/inv_mushroom_11" setAllPoints="true"/>-->
            </Layer>
            <Layer level="OVERLAY">
                <FontString font="GameFontHighlight" text="RP TimeTracker"> 
                    <Anchors>
                        <Anchor point="TOP" y="-5"/>
                    </Anchors>
                </FontString>

                <FontString name="$parentTRPLbl" font="GameFontHighlightLarge" text="TotalRP"> <Anchors> <Anchor point="TOP" y="-40"/></Anchors></FontString>
                <FontString name="$parentTRPStatus" font="GameFontNormal" text="Status:"> <Anchors> <Anchor point="TOPLEFT" x="20" y="-70"/></Anchors></FontString>
                <FontString name="$parentTRPStat" font="GameFontHighlight" parentKey="TRPSTAT"> <Anchors> <Anchor point="TOPRIGHT" x="-20" y="-70"/></Anchors></FontString>
                <FontString font="GameFontNormal" parentKey="LblTRPData" text="Use TRP-Data:"> <Anchors> <Anchor point="LEFT" relativeTo="$parentTRPStatus" relativePoint="LEFT" y="-25"/></Anchors></FontString>

                <FontString name="$parentTimerLbl" font="GameFontHighlightLarge" text="Timer">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentTRPLbl" relativePoint="BOTTOM" y="-70"/>
                    </Anchors>
                </FontString>  
            </Layer>
            <Layer level="HIGHLIGHT">
            </Layer>
        </Layers>
        <Frames>
            <CheckButton inherits="UICheckButtonTemplate" parentKey="CB">
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="$parentTRPStat" relativePoint="RIGHT" y="-25"/>
                </Anchors>
                <Scripts>
                    <OnClick function="UseTRPCB_Check" />
                </Scripts>
            </CheckButton>
                <Button name="$parentShowTimerButton" inherits="UIPanelButtonTemplate">
                    <Size x="170" y="25"/>
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentTimerLbl" relativePoint="BOTTOM" y="-5"/>
                    </Anchors>
                    <Scripts>
                        <OnLoad>self:SetText("Show all")</OnLoad>
                        <OnClick>RPTT.Commands.TimerStop()</OnClick>
                    </Scripts>
                </Button>  

                <Frame inherits="TimerFrame" hidden="false" >
                    <Anchors>
                        <Anchor point="BOTTOM" y="20"/>
                    </Anchors>
                </Frame>
        </Frames>
    </Frame>
</Ui>